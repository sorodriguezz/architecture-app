{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchFlow",
  "version": "../package.json",
  "identifier": "com.archflow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sorodriguezz/archflow/releases/latest/download/latest.json"
      ],
      "pubkey": "REEMPLAZAR_CON_LA_PUBKEY_DEL_UPDATER"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Sebastián Rodríguez",
    "copyright": "© 2026 ArchFlow",
    "category": "DeveloperTool",
    "shortDescription": "Asistente de decisiones de arquitectura de software",
    "longDescription": "ArchFlow analiza un contexto de negocio y produce decisiones de arquitectura documentadas: ADRs, diagramas Mermaid, matrices de trade-off y patrones aplicados, con Claude Code en modo headless.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
